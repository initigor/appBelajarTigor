# Salin menjadi .env.local jika ingin memakai database sungguhan saat `npm run dev`.
# Tanpa file ini, dev server memakai database sementara di memori.

# Rahasia untuk menandatangani sesi login (minimal 16 karakter acak).
AUTH_SECRET=

# Diisi otomatis oleh Vercel setelah Upstash Redis dihubungkan ke project.
# Bisa diambil ke laptop dengan: npx vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
